<div class="c-search-filter"><label for="catalogue-filter">Find <%= section ? section : 'a page' %></label><input id="catalogue-filter" type="search" data-catalogue-filter autocomplete="off"><p role="status" data-catalogue-status></p></div>
<% groups = section ? section_groups(section) : search_groups %>
<% groups.each do |group, resources| %><section data-catalogue-group><h2><%= escape(group) %></h2><ul class="c-catalogue">
<% resources.each do |resource| %><li data-catalogue-item><h3><a href="<%= docs_path('/' + resource.destination_path) %>"><%= escape(resource.data.title) %></a></h3><p><%= escape(resource.data.description) %></p><% if resource.data.status == 'reference' %><p class="c-catalogue__meta"><%= section_for(resource) == 'styles' ? 'Reference guidance · apply within its stated scope' : 'Reference pattern · adapt and test before connecting to Home Assistant' %></p><% end %></li><% end %>
</ul></section><% end %>
