---
<h1>Sitemap</h1><p>Browse every guidance page. Standalone examples are linked from their owning component or pattern.</p>
<% data.navigation.sections.each do |section| %>
<section data-sitemap-section="<%= section.id %>">
  <h2><a href="<%= docs_path(section.path) %>"><%= section.title %></a></h2>
  <ul><% guide_pages.select { |resource| section_for(resource) == section.id && '/' + resource.destination_path != section.path }.sort_by { |resource| resource.data.title }.each do |resource| %>
    <li><a href="<%= docs_path('/' + resource.destination_path) %>"><%= escape(resource.data.title) %></a></li>
  <% end %></ul>
</section>
<% end %>
