<%
  fragment = Nokogiri::HTML::DocumentFragment.parse(yield)
  headings = fragment.children.select { |node| node.name == 'h2' }
  # Component pages lead with the default rendered example, as the official
  # Design System does; supporting variants remain beside their guidance.
  first_example = fragment.at_css('.c-example')
  if current_section == 'components' && first_example && headings.first
    prior = first_example.previous_element
    while prior && !%w[h2 h3].include?(prior.name)
      prior = prior.previous_element
    end
    if prior && %w[h2 h3].include?(prior.name)
      reference = Nokogiri::XML::Node.new('p', fragment.document)
      link = Nokogiri::XML::Node.new('a', fragment.document)
      link['href'] = "##{first_example['id']}"
      link.content = 'View this example at the start of the page'
      reference.add_child(link)
      first_example.add_previous_sibling(reference)
    end
    first_example.unlink
    headings.first.add_previous_sibling(first_example)
  end
  if headings.length >= 3 && !home_page?
    contents = Nokogiri::XML::Node.new('nav', fragment.document)
    contents['class'] = 'c-on-this-page'
    contents['aria-label'] = 'On this page'
    title = Nokogiri::XML::Node.new('h2', fragment.document)
    title.content = 'On this page'
    contents.add_child(title)
    list = Nokogiri::XML::Node.new('ul', fragment.document)
    headings.each_with_index do |heading, index|
      heading['id'] ||= "section-#{index + 1}"
      item = Nokogiri::XML::Node.new('li', fragment.document)
      link = Nokogiri::XML::Node.new('a', fragment.document)
      link['href'] = "##{heading['id']}"
      link.content = heading.text
      item.add_child(link)
      list.add_child(item)
    end
    contents.add_child(list)
    headings.first.add_previous_sibling(contents)
  end
  table_labels = Hash.new(0)
  fragment.css('table').each do |table|
    heading = table.xpath('preceding::*[self::h2 or self::h3][1]').first
    disclosure = table.ancestors('details').first
    summary = disclosure&.at_xpath('./summary')
    caption = table.at_xpath('./caption')
    label = [heading&.text || current_page.data.title, summary&.text, caption&.text].compact.map(&:strip).reject(&:empty?).uniq.join(' — ')
    table_labels[label] += 1
    label = "#{label} (#{table_labels[label]})" if table_labels[label] > 1
    wrapper = Nokogiri::XML::Node.new('div', fragment.document)
    wrapper['class'] = 'c-table-region'
    wrapper['role'] = 'region'
    wrapper['tabindex'] = '0'
    wrapper['aria-label'] = "#{label} table"
    table.replace(wrapper)
    wrapper.add_child(table)
  end
  content = fragment.to_html
  content_for :page_contents do
    single_page_table_of_contents(content, max_level: 2)
  end
  wrap_layout :civica_core do
    content
  end
%>
