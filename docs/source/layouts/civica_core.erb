<% illustrated_page = !!data['page-illustrations'][current_page.destination_path] %>
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><meta name="theme-color" content="#1d70b8">
<title><%= escape(current_page.data.title) %> – civica Design System</title>
<meta name="description" content="<%= escape(current_page.data.description || 'A clear, consistent Home Assistant interface inspired by UK public service design.') %>">
<%= stylesheet_link_tag 'screen' %><%= favicon_tag 'favicon.ico' %>
<link rel="icon" type="image/svg+xml" href="<%= docs_path('/images/favicon.svg') %>"><link rel="apple-touch-icon" href="<%= docs_path('/images/apple-touch-icon.png') %>"><link rel="manifest" href="<%= docs_path('/site.webmanifest') %>">
</head>
<body class="<%= home_page? ? 'c-home' : 'c-guide' %>">
<a class="c-skip" href="#main-content">Skip to main content</a>
<%= site_notice %>
<%= javascript_include_tag 'site-notice' %>
<header class="c-header"><div class="c-container c-header__inner">
<a class="c-brand" href="<%= docs_path('/index.html') %>" aria-label="civica Design System home"><img src="<%= docs_path('/images/civica-lockup.svg') %>" alt="civica" width="236" height="52"><span class="c-header__name">Design System</span></a>
<form class="c-search" role="search" action="<%= docs_path('/search.html') %>"><label class="govuk-visually-hidden" for="site-search">Search Design System</label><input id="site-search" name="q" type="search" placeholder="Search Design System"><button type="submit" aria-label="Search"><svg aria-hidden="true" viewBox="0 0 24 24" width="22" height="22"><circle cx="10" cy="10" r="6" fill="none" stroke="currentColor" stroke-width="2"/><path d="m15 15 6 6" stroke="currentColor" stroke-width="2"/></svg></button></form>
</div></header>
<nav class="c-navigation" aria-label="Main navigation"><div class="c-container"><button type="button" class="c-menu-toggle" aria-expanded="true" aria-controls="primary-navigation" hidden>Menu</button><ul id="primary-navigation">
<% data.navigation.sections.each do |section| %><li><a href="<%= docs_path(section.path) %>"<%= ' aria-current="true"' if current_section == section.id %>><%= section.title %></a></li><% end %>
</ul></div></nav>
<% if home_page? %>
<main id="main-content" class="c-home-content" tabindex="-1"><%= yield %></main>
<% else %>
<div class="c-container c-page<%= ' c-page--illustrated' if illustrated_page %>">
<aside class="c-sidebar" aria-label="Section navigation">
<% section = data.navigation.sections.find { |item| item.id == current_section } %>
<details class="c-section-menu" open><summary><%= section ? section.title : 'Design System' %> navigation</summary>
<% if section %><h2><a href="<%= docs_path(section.path) %>"<%= ' aria-current="page"' if '/' + current_page.destination_path == section.path %>><%= section.title %></a></h2>
<% section_groups(section.id).each do |group, resources| %>
<details class="c-nav-group"<%= ' open' if resources.any? { |r| r.destination_path == current_page.destination_path } || ['Guidance', 'Writing standards', 'Home Assistant components'].include?(group) %>><summary><%= group %></summary><ul>
<% resources.each do |resource| %><li><a href="<%= docs_path('/' + resource.destination_path) %>"<%= ' aria-current="page"' if resource.destination_path == current_page.destination_path %>><%= escape(resource.data.title) %></a></li><% end %>
</ul></details><% end %>
<% else %><ul><% data.navigation.sections.each do |item| %><li><a href="<%= docs_path(item.path) %>"><%= item.title %></a></li><% end %></ul><% end %>
</details></aside>
<main class="technical-documentation c-content<%= ' c-content--illustrated' if illustrated_page %>" id="main-content" tabindex="-1">
<% if illustrated_page %><%= yield_content :illustrated_header %><div class="c-reading-content"><% else %><%= partial 'partials/breadcrumbs' %><% end %>
<%= yield %>
<%= partial 'partials/component_family' %>
<%= partial 'partials/history' %>
<div class="c-contribute"><h2>Help improve this guidance</h2><p>Review responsibility: the civica repository maintainers. Follow the <a href="<%= docs_path('/content/content-review.html') %>">content review process</a> when changing this guidance.</p><p><a href="https://github.com/nathcymru/civica/issues/new">Report an issue or suggest a change</a>. Include the page, the task you were trying to complete and what happened. Do not include household credentials or private sensor data.</p><p><a href="https://github.com/nathcymru/civica/blob/main/<%= current_page.data.repository_source || ('docs/source/' + current_page.source_file.sub(root + '/source/', '')) %>">View this page’s source</a></p></div>
<%= '</div>' if illustrated_page %>
</main></div><% end %>
<footer class="c-footer"><div class="c-container"><ul><li><a href="<%= docs_path('/accessibility/index.html') %>">Accessibility</a></li><li><a href="<%= docs_path('/community/licensing.html') %>">Licence</a></li><li><a href="<%= docs_path('/sitemap.html') %>">Sitemap</a></li><li><a href="<%= docs_path('/llms.txt') %>">AI reading guide</a></li><li><a href="https://github.com/nathcymru/civica">GitHub repository</a></li></ul><div class="c-footer__identity"><img src="<%= docs_path('/images/civica-emblem.svg') %>" alt="" width="40" height="40"><p>civica is independent of the UK Government and uses open-source GOV.UK Frontend components; see <a href="<%= docs_path('/community/licensing.html') %>">Licence and attribution</a>.</p></div></div></footer>
<%= javascript_include_tag 'civica-docs', defer: true %>
</body></html>
